{s === 'aries' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21V8"></path>
    <path d="M12 8C12 5 10 3 7 3C4 3 3 5 3 7.5C3 11 8 12 12 12"></path>
    <path d="M12 8C12 5 14 3 17 3C20 3 21 5 21 7.5C21 11 16 12 12 12"></path>
  </svg>
)}

