---
// ZodiacSvg.astro - High-Precision Hairline Astrological Vector Glyphs
interface Props {
  sign: string;
  class?: string;
  size?: number;
}

const { sign, class: className = "w-5 h-5", size = 20 } = Astro.props;
const s = sign.toLowerCase();
