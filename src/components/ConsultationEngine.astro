---
// ConsultationEngine.astro - Clean White Contact & Appointment Section
---

<section id="contact" class="py-16 lg:py-24 bg-warm-ivory border-b border-amber-100/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-700 bg-amber-100/70 border border-amber-300 px-3.5 py-1.5 rounded-full uppercase tracking-wider">
        <span>📍 VISIT SANCTUARY OR CALL</span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-950 tracking-tight">
        Contact Pandith Vikram Ji
      </h2>
      <p class="text-base text-gray-600 leading-relaxed font-normal">
        Visit our Hollywood Blvd sanctuary in Los Angeles or connect remotely via phone and WhatsApp. Available 24 hours a day, 7 days a week.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Sanctuary Contact Details & Hours -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Sanctuary Details Card -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 space-y-6 shadow-sm">
          
          <h3 class="font-heading text-xl font-bold text-gray-900 border-b border-gray-100 pb-3">
            Sanctuary Information
          </h3>

          <!-- Address -->
          <div class="flex items-start gap-4">
            <span class="w-10 h-10 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center shrink-0 border border-amber-200">
              📍
            </span>
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Physical Address</span>
              <p class="text-sm font-bold text-gray-900 mt-0.5 leading-snug">
                7001 Hollywood Blvd, Los Angeles, CA 90028, United States
              </p>
              <a 
                href="https://maps.google.com/?q=7001+Hollywood+Blvd,+Los+Angeles,+CA+90028" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-block text-xs font-bold text-amber-700 hover:text-amber-900 mt-1.5 underline"
              >
                View on Google Maps ➔
              </a>
            </div>
          </div>

          <!-- Phone Number -->
          <div class="flex items-start gap-4">
            <span class="w-10 h-10 rounded-lg bg-red-50 text-red-700 flex items-center justify-center shrink-0 border border-red-200">
              📞
            </span>
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Direct Telephone</span>
              <a href="tel:+15103714626" class="text-base font-bold text-red-800 hover:text-red-950 mt-0.5 block">
                +1 510-371-4626
              </a>
              <span class="text-xs text-gray-500">Toll-free across USA & Canada</span>
            </div>
          </div>

          <!-- WhatsApp -->
          <div class="flex items-start gap-4">
            <span class="w-10 h-10 rounded-lg bg-green-50 text-green-700 flex items-center justify-center shrink-0 border border-green-200">
              💬
            </span>
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">WhatsApp 24/7</span>
              <a href="https://wa.me/15103714626" target="_blank" rel="noopener noreferrer" class="text-base font-bold text-green-700 hover:text-green-800 mt-0.5 block">
                +1 510-371-4626
              </a>
              <span class="text-xs text-gray-500">Fast replies within 5–10 minutes</span>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex items-start gap-4">
            <span class="w-10 h-10 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center shrink-0 border border-amber-200">
              ⏰
            </span>
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Consultation Hours</span>
              <p class="text-sm font-semibold text-gray-900 mt-0.5">
                Open 24 Hours / 7 Days a Week
              </p>
              <span class="text-xs text-green-600 font-semibold">● Open Today for Walk-ins & Phone Sessions</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row gap-3">
            <a href="tel:+15103714626" class="btn-primary-call flex-1 text-center text-sm py-3">
              📞 Call Directly
            </a>
            <a href="https://wa.me/15103714626" target="_blank" rel="noopener noreferrer" class="btn-primary-whatsapp flex-1 text-center text-sm py-3">
              💬 Chat on WhatsApp
            </a>
          </div>

        </div>

      </div>

      <!-- Right Column: Full Appointment Booking Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-sm">
          
          <div class="mb-6">
            <h3 class="font-heading text-2xl font-bold text-gray-900">
              Schedule Your Confidential Session
            </h3>
            <p class="text-xs sm:text-sm text-gray-600 mt-1">
              Fill in your details below. Pandith Vikram will personally review your problem and contact you.
            </p>
          </div>

          <form id="contact-full-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="c_name" class="block text-xs font-semibold text-gray-700 mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  id="c_name" 
                  name="name" 
                  required 
                  placeholder="e.g. John Doe" 
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
                />
              </div>

              <div>
                <label for="c_phone" class="block text-xs font-semibold text-gray-700 mb-1">Phone Number *</label>
                <input 
                  type="tel" 
                  id="c_phone" 
                  name="phone" 
                  required 
                  placeholder="+1 (555) 000-0000" 
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="c_email" class="block text-xs font-semibold text-gray-700 mb-1">Email Address</label>
                <input 
                  type="email" 
                  id="c_email" 
                  name="email" 
                  placeholder="your.email@example.com" 
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
                />
              </div>

              <div>
                <label for="c_service" class="block text-xs font-semibold text-gray-700 mb-1">Primary Concern / Service *</label>
                <select 
                  id="c_service" 
                  name="service" 
                  required 
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all"
                >
                  <option value="Get Ex Love Back">Get Ex Love Back & Love Spell</option>
                  <option value="Black Magic Removal">Black Magic & Evil Spirit Removal</option>
                  <option value="Husband Wife Dispute">Husband-Wife & Marriage Dispute</option>
                  <option value="Palmistry & Face Reading">Palmistry & Face Reading</option>
                  <option value="Kundali & Horoscope Reading">Kundali & Birth Chart Reading</option>
                  <option value="Business & Finance Problem">Business & Career Problem</option>
                  <option value="Spiritual Healing">Spiritual Healing & Mental Peace</option>
                  <option value="Other Urgent Concern">Other Urgent Life Concern</option>
                </select>
              </div>
            </div>

            <div>
              <label for="c_dob" class="block text-xs font-semibold text-gray-700 mb-1">Date of Birth (Optional for Janam Kundali)</label>
              <input 
                type="date" 
                id="c_dob" 
                name="dob" 
                class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all"
              />
            </div>

            <div>
              <label for="c_message" class="block text-xs font-semibold text-gray-700 mb-1">Describe Your Situation in Confidence</label>
              <textarea 
                id="c_message" 
                name="message" 
                rows="3" 
                placeholder="Share your concerns, questions, or background details..." 
                class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full btn-primary-call py-3.5 text-base font-bold shadow-md shadow-red-900/20 cursor-pointer"
            >
              Submit For Immediate Astrological Review ➔
            </button>

            <!-- Success Box -->
            <div id="contact-full-success" class="hidden p-4 bg-green-50 border border-green-200 text-green-800 rounded-md text-xs font-semibold text-center">
              ✓ Message Received! Pandith Vikram Ji will contact you via WhatsApp/Phone within 15 minutes.
            </div>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-full-form');
  const contactSuccess = document.getElementById('contact-full-success');

  if (contactForm && contactSuccess) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactSuccess.classList.remove('hidden');
      contactForm.reset();
      setTimeout(() => {
        contactSuccess.classList.add('hidden');
      }, 7000);
    });
  }
</script>
