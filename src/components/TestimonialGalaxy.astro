---
// TestimonialGalaxy.astro - Clean White Real Client Testimonials Section
const reviews = [
  {
    id: 1,
    name: "Sarah Jenkins",
    location: "Los Angeles, California",
    service: "Ex Love Back & Relationship Healing",
    rating: 5,
    text: "My fiancé and I were separated for 8 months after continuous toxic arguments and outside interference. I was devastated and lost all hope. I visited Pandith Vikram at his Hollywood Blvd sanctuary. Within 10 days of his Vedic prayers and remedies, my partner called me asking for forgiveness. We are happily married now!"
  },
  {
    id: 2,
    name: "Rajesh & Priya Patel",
    location: "San Jose, California",
    service: "Husband-Wife Dispute & Family Peace",
    rating: 5,
    text: "We were literally on the brink of filing for divorce due to constant family misunderstandings and financial stress. Pandith Vikram analyzed our Kundalis and accurately pointed out a severe Rahu-Ketu dosha. His homa and gemstone remedies saved our 12-year marriage. Truly a God-sent healer."
  },
  {
    id: 3,
    name: "Michael R.",
    location: "New York, USA",
    service: "Black Magic & Evil Spirit Removal",
    rating: 5,
    text: "For nearly a year, I experienced constant night terrors, sudden business losses, and suffocating exhaustion that doctors couldn't explain. Pandith Vikram performed an ancient cleansing ritual for me. Within three days, the oppressive darkness lifted completely. My energy and business are back!"
  },
  {
    id: 4,
    name: "Anita Sharma",
    location: "San Francisco, California",
    service: "Career & Financial Problem Solution",
    rating: 5,
    text: "My software startup was trapped in an excruciating capital freeze and contracts kept canceling at the last minute. Pandith Ji audited our office Vastu and gave me a specific Muhurta window. Within 48 hours, our lead investor signed. I consult him for all major life decisions now."
  }
];
---

<section id="testimonials" class="py-16 lg:py-24 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3.5 py-1.5 rounded-full uppercase tracking-wider">
        <span>⭐ 4.9/5 RATED BY 5,000+ SEEKERS</span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-950 tracking-tight">
        What Our Clients Say About Pandith Vikram
      </h2>
      <p class="text-base text-gray-600 leading-relaxed font-normal">
        Real stories of restored relationships, dissolved court cases, financial breakthroughs, and spiritual protection.
      </p>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {reviews.map((rev) => (
        <div class="bg-warm-ivory rounded-xl border border-amber-200/70 p-7 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <!-- Stars -->
            <div class="flex items-center gap-1 text-amber-500 text-sm">
              {"★".repeat(rev.rating)}
            </div>
            
            <!-- Service Tag -->
            <span class="inline-block text-[11px] font-bold text-amber-800 bg-amber-100/60 px-2.5 py-1 rounded">
              {rev.service}
            </span>

            <!-- Quote Text -->
            <p class="text-sm text-gray-700 leading-relaxed italic">
              "{rev.text}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-4 mt-4 border-t border-amber-200/50 flex items-center justify-between">
            <div>
              <span class="block font-heading text-base font-bold text-gray-900">{rev.name}</span>
              <span class="block text-xs text-gray-500">{rev.location}</span>
            </div>
            <span class="text-xs font-semibold text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full">
              ✓ Verified Client
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Bar -->
    <div class="mt-12 text-center bg-amber-50/80 rounded-xl border border-amber-200 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h4 class="font-heading text-lg font-bold text-gray-900">Are You Ready to Overcome Your Problems?</h4>
        <p class="text-xs text-gray-600">Join thousands of individuals who transformed their lives with Pandith Vikram's guidance.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="tel:+15103714626" class="btn-primary-call text-xs sm:text-sm py-2.5 px-5">
          📞 Call: +1 510-371-4626
        </a>
        <a href="https://wa.me/15103714626" target="_blank" rel="noopener noreferrer" class="btn-primary-whatsapp text-xs sm:text-sm py-2.5 px-5">
          💬 WhatsApp
        </a>
      </div>
    </div>

  </div>
</section>
