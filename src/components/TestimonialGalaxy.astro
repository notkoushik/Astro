<section id="testimonials" class="py-32 relative border-t border-hairline">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- Section Header: Editorial & Vast Spacing -->
    <div class="max-w-3xl mb-20 space-y-4">
      <div class="text-[10px] tracking-[0.35em] text-[#C8A45C] uppercase font-mono">
        RECORD OF TRUTH &bull; SEEKER CHRONICLES
      </div>
      <h2 class="font-editorial text-4xl sm:text-5xl md:text-6xl text-[#F2EEE7] font-normal leading-[1.08]">
        Chronicles of Realignment
      </h2>
      <p class="font-sans text-xs sm:text-sm text-[#9696A5] font-light leading-relaxed max-w-xl">
        Reflections from individuals, executives, and couples across the world who sought guidance at moments of profound vulnerability and found lasting sovereignty.
      </p>
    </div>

    <!-- Editorial Quote Spread (Single-Column Generous Breathing Room) -->
    <div class="divide-y divide-hairline border-y border-hairline">
      {accounts.map((item) => (
        <article class="py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Column 1: Seeker Identity & Geocoordinates -->
          <div class="lg:col-span-4 space-y-2">
            <span class="font-editorial text-2xl text-[#F2EEE7] block">
              {item.seeker}
            </span>
            <div class="text-[9px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase" set:html={item.location}></div>
            <div class="text-[10px] font-sans tracking-[0.15em] text-[#9696A5] uppercase pt-1">
              {item.discipline}
            </div>
            <div class="pt-2 text-[10px] font-mono text-[#F2EEE7]/80">
              &bull; {item.metric}
            </div>
          </div>

          <!-- Column 2: The Extended Narrative Quote -->
          <div class="lg:col-span-8">
            <blockquote class="font-editorial text-xl sm:text-2xl text-[#F2EEE7] font-light leading-relaxed italic">
              "{item.quote}"
            </blockquote>
          </div>

        </article>
      ))}
    </div>

    <!-- Legal Compliance Disclaimer in Fine Print -->
    <div class="mt-16 text-[10px] font-mono text-[#9696A5]/60 tracking-wider">
      *OBSERVATORY NOTE: Jyotish Vedic astrology is a personalized sacred advisory science. Results unfold in accordance with each individual's unique karmic ephemeris and natal chart placements. Strict confidentiality is permanently guaranteed.
