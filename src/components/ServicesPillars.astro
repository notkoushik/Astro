<section id="services" class="py-16 lg:py-24 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Section Title & Introduction -->
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3.5 py-1.5 rounded-full uppercase tracking-wider">
        <span>🕉️</span>
        <span>Trusted Vedic Astrology Services</span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-950 tracking-tight">
        Sacred Vedic Solutions for Every Life Problem
      </h2>
      <p class="text-base text-gray-600 leading-relaxed font-normal">
        No matter how complex or hopeless your situation may feel, ancient Vedic astrology has proven solutions. Pandith Vikram has reunited thousands of families and resolved deep crises across California and the USA.
      </p>
    </div>

    <!-- 8 High-Impact Commercial Service Cards Grid with Authentic Photos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((svc) => (
        <div id={svc.id} class="bg-white rounded-xl border border-gray-200 overflow-hidden flex flex-col justify-between hover:border-amber-400 hover:shadow-xl hover:shadow-amber-900/10 transition-all duration-200 group">
          
          <div>
            <!-- Authentic Visual Header -->
            <div class="relative h-48 w-full overflow-hidden bg-amber-50">
              <img 
                src={svc.image} 
                alt={svc.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              
              <!-- Floating Icon Emblem -->
              <span class="absolute top-3 left-3 w-9 h-9 rounded-lg bg-white/95 backdrop-blur-sm text-lg flex items-center justify-center shadow-md">
                {svc.icon}
              </span>

              <!-- Badge -->
              <span class="absolute top-3 right-3 text-[10px] font-bold uppercase tracking-wider bg-red-700 text-white px-2.5 py-1 rounded-full shadow-md">
                {svc.badge}
              </span>

              <!-- Title on image bottom overlay for clarity -->
              <div class="absolute bottom-2.5 left-3 right-3 text-white">
                <span class="text-[11px] font-medium text-amber-200 block drop-shadow-sm">{svc.subtitle}</span>
              </div>
            </div>

            <!-- Content Body -->
            <div class="p-5 space-y-3">
              <h3 class="font-heading text-lg font-bold text-gray-900 leading-snug group-hover:text-amber-700 transition-colors">
                {svc.title}
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed font-normal">
                {svc.desc}
              </p>
            </div>
          </div>

          <!-- Direct Conversion CTAs per card -->
          <div class="p-5 pt-0 border-t border-gray-100 flex items-center gap-2 mt-2">
            <a 
              href="tel:+15103714626" 
              class="flex-1 bg-red-700 hover:bg-red-800 text-white text-xs font-bold py-2.5 px-2 rounded-lg text-center transition-colors shadow-xs"
              aria-label={`Call Pandith Vikram for ${svc.title}`}
            >
              📞 Call Now
            </a>
            <a 
              href="https://wa.me/15103714626" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex-1 bg-[#25D366] hover:bg-[#20ba5a] text-white text-xs font-bold py-2.5 px-2 rounded-lg text-center transition-colors shadow-xs"
              aria-label={`WhatsApp Pandith Vikram for ${svc.title}`}
            >
              💬 WhatsApp
            </a>
          </div>

