---

<section id="zodiac" class="py-28 relative overflow-hidden border-t border-hairline">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- Section Header: Refined Editorial Typography with Negative Space -->
    <div class="max-w-2xl mb-16 space-y-3">
      <div class="text-[10px] tracking-[0.3em] text-[#C8A45C] uppercase font-mono">
        EPHEMERIS &bull; 360° SIDEREAL ECLIPTIC
      </div>
      <h2 class="font-editorial text-4xl sm:text-5xl text-[#F2EEE7] font-normal tracking-[-0.01em]">
        The Celestial Ecliptic Scale
      </h2>
      <p class="font-sans text-xs sm:text-sm text-[#9696A5] font-light leading-relaxed">
        Navigate the continuous 360-degree astronomical zodiac belt. Each sector represents a precise 30-degree arc of cosmic longitude, governed by specific Vedic planetary grahas and nakshatra lodgings.
      </p>
    </div>

    <!-- The Horizontal Celestial Zodiac Instrument Track -->
    <div class="w-full pb-8 border-b border-hairline">
      
      <!-- Astronomical Scale Track with Degree Ticks -->
      <div class="relative w-full overflow-x-auto pb-4 scrollbar-none">
        
        <!-- Continuous Ecliptic Line & Major Ticks -->
        <div class="min-w-[960px] relative pt-6 pb-2">
          
          <!-- Continuous 1px Astronomical Reference Line -->
          <div class="absolute top-11 left-0 right-0 h-[1px] bg-[#F2EEE7]/12"></div>

          <!-- 12 Continuous Node Positions -->
          <div class="grid grid-cols-12 gap-0 relative z-10">
            {zodiacSigns.map((sign, idx) => (
              <button
                type="button"
                data-zodiac-id={sign.id}
                class={`zodiac-node-btn flex flex-col items-center group cursor-pointer transition-all duration-300 py-1 ${
                  idx === 0 ? 'active-node text-[#C8A45C]' : 'text-[#9696A5] hover:text-[#F2EEE7]'
                }`}
              >
                <!-- Degree Tick Label -->
                <span class="text-[9px] font-mono tracking-widest text-[#9696A5]/50 mb-1.5 group-hover:text-[#F2EEE7] font-light">
                  {sign.degStart}
                </span>

                <!-- Astronomical Reticle Dial with Bespoke Vector SVG (Zero Purple Emojis!) -->
                <div class={`node-dial w-9 h-9 rounded-full border flex items-center justify-center transition-all duration-300 ${
                  idx === 0 
                    ? 'border-[#C8A45C] bg-[#C8A45C]/15 text-[#C8A45C] shadow-[0_0_15px_rgba(200,164,92,0.35)]' 
                    : 'border-[#F2EEE7]/15 bg-[#05060B] text-[#9696A5] group-hover:border-[#F2EEE7]/40 group-hover:text-[#F2EEE7]'
                }`}>
                  <ZodiacSvg sign={sign.id} size={18} class="transition-colors" />
                </div>

                <!-- Clean Editorial Name -->
                <span class="text-[9px] font-sans font-medium tracking-[0.18em] uppercase block mt-2.5 transition-colors">
                  {sign.name}
                </span>
              </button>
            ))}
          </div>

        </div>

      </div>

    </div>

    <!-- Refined Astronomical Readout Panel (Observatory Interface) -->
    <div id="zodiac-telemetry-readout" class="mt-12 pt-4">
      
      <!-- Top Primary Row: Identity & Large Degree Coordinates -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pb-8 border-b border-hairline">
        
        <!-- Left: Large Astrological Degree & Name -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-center gap-3">
            <div id="z-svg-container" class="w-10 h-10 rounded-full border border-[#C8A45C]/40 bg-[#C8A45C]/10 flex items-center justify-center text-[#C8A45C]">
              <ZodiacSvg sign="aries" size={22} />
            </div>
            <div class="text-[10px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase">
              <span id="z-deg-span">00°00' — 30°00' ECLIPTIC ARC</span>
            </div>
          </div>

          <h3 id="z-name" class="font-editorial text-4xl sm:text-5xl font-normal text-[#F2EEE7] tracking-tight">
            ARIES
          </h3>

          <div id="z-sanskrit" class="text-xs font-mono uppercase tracking-[0.25em] text-[#9696A5]">
            MESHA RASHI &bull; PRIME FIRE
          </div>

          <div class="pt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs font-sans text-[#9696A5]">
            <div>ELEMENT: <span id="z-element" class="text-[#F2EEE7]">TEJAS (FIRE)</span></div>
            <div>QUALITY: <span id="z-quality" class="text-[#F2EEE7]">CHARA (CARDINAL)</span></div>
            <div>RULING GRAHA: <span id="z-ruler" class="text-[#C8A45C]">MANGAL (MARS)</span></div>
          </div>
        </div>

        <!-- Right: Poetic Synthesis & Vedic Placement -->
        <div class="lg:col-span-7 space-y-4">
          <div class="text-[10px] font-mono tracking-[0.25em] text-[#9696A5] uppercase">
            EPHEMERIS SYNTHESIS
          </div>

          <p id="z-synthesis" class="font-editorial text-lg sm:text-xl text-[#F2EEE7] font-light leading-relaxed italic">
            "Aries initiates the cosmic wheel with undiluted primal impulse. When Mars is channeled through Vedic pacification, restless impulsiveness dissolves into targeted commercial and spiritual leadership."
          </p>

          <div class="pt-3 border-t border-hairline/60 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
            <div>
              <span class="text-[#9696A5]/70 block text-[9px] tracking-widest uppercase">CONSECRATED GEMSTONE</span>
              <span id="z-gemstone" class="text-[#F2EEE7] font-sans text-xs">PRAVALA (RED CORAL)</span>
            </div>
            <div>
              <span class="text-[#9696A5]/70 block text-[9px] tracking-widest uppercase">NAKSHATRA RANGE</span>
              <span id="z-nakshatras" class="text-[#F2EEE7] font-sans text-xs">ASHWINI · BHARANI · KRITTIKA</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Bottom Secondary Row: Vedic Beej Mantra & Calculation CTA -->
      <div class="pt-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1">
          <span class="text-[9px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase block">VEDIC REMEDIAL BEEJ MANTRA</span>
          <span id="z-mantra" class="font-editorial text-base text-[#F2EEE7] italic">
            "Om Kram Kreem Kroum Sah Bhaumaya Namah"
          </span>
          <span class="text-[10px] text-[#9696A5] block">Recitation at dawn neutralizes malefic transit friction</span>
        </div>

        <a href="#consultation" class="btn-observatory-primary shrink-0">
          CALCULATE NATAL LAGNA FOR THIS SIGN
        </a>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ zodiacSigns }}>
  const nodeButtons = document.querySelectorAll('.zodiac-node-btn');
  const svgContainer = document.getElementById('z-svg-container');
  const spanEl = document.getElementById('z-deg-span');
  const nameEl = document.getElementById('z-name');
  const sanskritEl = document.getElementById('z-sanskrit');
  const elementEl = document.getElementById('z-element');
  const qualityEl = document.getElementById('z-quality');
  const rulerEl = document.getElementById('z-ruler');
  const synthesisEl = document.getElementById('z-synthesis');
  const gemEl = document.getElementById('z-gemstone');
  const nakshatraEl = document.getElementById('z-nakshatras');
  const mantraEl = document.getElementById('z-mantra');

  nodeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-zodiac-id');
      const data = zodiacSigns.find((s) => s.id === id);
      if (!data) return;

      // Update Node Dials and Active State
      nodeButtons.forEach((b) => {
        b.className = 'zodiac-node-btn flex flex-col items-center group cursor-pointer transition-all duration-300 py-1 text-[#9696A5] hover:text-[#F2EEE7]';
        const dial = b.querySelector('.node-dial');
        if (dial) {
          dial.className = 'node-dial w-9 h-9 rounded-full border flex items-center justify-center transition-all duration-300 border-[#F2EEE7]/15 bg-[#05060B] text-[#9696A5] group-hover:border-[#F2EEE7]/40 group-hover:text-[#F2EEE7]';
        }
      });

      btn.className = 'zodiac-node-btn active-node flex flex-col items-center group cursor-pointer transition-all duration-300 py-1 text-[#C8A45C]';
      const activeDial = btn.querySelector('.node-dial');
      if (activeDial) {
        activeDial.className = 'node-dial w-9 h-9 rounded-full border flex items-center justify-center transition-all duration-300 border-[#C8A45C] bg-[#C8A45C]/15 text-[#C8A45C] shadow-[0_0_15px_rgba(200,164,92,0.35)]';
      }

      // Clone the active SVG into the readout container
      const btnSvg = btn.querySelector('svg');
      if (svgContainer && btnSvg) {
        svgContainer.innerHTML = '';
        const clonedSvg = btnSvg.cloneNode(true);
        clonedSvg.setAttribute('width', '24');
        clonedSvg.setAttribute('height', '24');
        svgContainer.appendChild(clonedSvg);
      }

      // Update Astronomical Readout
      if (spanEl) spanEl.textContent = `${data.degSpan} ECLIPTIC ARC`;
      if (nameEl) nameEl.textContent = data.name;
      if (sanskritEl) sanskritEl.textContent = `${data.sanskrit} RASHI • ${data.element}`;
      if (elementEl) elementEl.textContent = data.element;
      if (qualityEl) qualityEl.textContent = data.quality;
      if (rulerEl) rulerEl.textContent = data.ruler;
      if (synthesisEl) synthesisEl.textContent = `"${data.synthesis}"`;
      if (gemEl) gemEl.textContent = data.gemstone;
      if (nakshatraEl) nakshatraEl.textContent = data.nakshatras;
      if (mantraEl) mantraEl.textContent = `"${data.mantra}"`;
    });
  });
</script>
