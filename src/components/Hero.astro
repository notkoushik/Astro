---
// Hero.astro - Clean White Commercial Hero with Instant Appointment Form
---

<section id="home" class="relative bg-gradient-to-b from-amber-50/50 via-white to-warm-ivory py-12 lg:py-16 border-b border-amber-100/60 overflow-hidden">
  
  <!-- Subtle Traditional Mandala Watermark in Background -->
  <div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-amber-400/5 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-24 bottom-0 w-96 h-96 rounded-full bg-red-600/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Column: Authority Copy, Badges & Direct Calling -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Sacred Vedic Astrologer Authority Badge with Authentic Portrait -->
        <div class="flex items-center gap-3 bg-white/95 border border-amber-300 p-1.5 pr-4 rounded-full shadow-sm w-fit">
          <img 
            src="/images/pandith-vikram.jpg" 
            alt="Pandith Vikram Ji - Indian Astrologer Los Angeles" 
            class="w-12 h-12 rounded-full object-cover object-top border-2 border-amber-500 shadow-xs"
            loading="eager"
          />
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold text-gray-950">Pandith Vikram Ji</span>
              <span class="text-[10px] bg-red-700 text-white font-bold px-1.5 py-0.5 rounded-full">VERIFIED MASTER</span>
            </div>
            <span class="text-[11px] text-amber-900 font-semibold block">World Famous Indian Astrologer in Los Angeles, California</span>
          </div>
        </div>

        <!-- Main Heading -->
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-[46px] font-bold text-gray-950 leading-[1.15] tracking-tight">
          Solve All Your Life Problems With Authentic 
          <span class="text-gradient-maroon block mt-1">Vedic Astrology & Spiritual Healing</span>
        </h1>

        <!-- Subheading -->
        <p class="text-base sm:text-lg text-gray-700 leading-relaxed max-w-2xl font-normal">
          Are you facing heart-wrenching love breakups, constant family disputes, sudden financial blockages, or dark negative energy? Consult <strong class="text-gray-900 font-bold">Pandith Vikram</strong> for 100% confidential and permanent solutions derived from three generations of sacred Vedic wisdom.
        </p>

        <!-- Trust Metric Pillars -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-2 border-y border-amber-200/60">
          <div class="p-2.5 bg-white rounded border border-gray-100 shadow-xs text-center">
            <span class="block font-heading text-2xl font-bold text-amber-700">35+</span>
            <span class="block text-[11px] font-semibold text-gray-600 uppercase">Years Experience</span>
          </div>
          <div class="p-2.5 bg-white rounded border border-gray-100 shadow-xs text-center">
            <span class="block font-heading text-2xl font-bold text-amber-700">100%</span>
            <span class="block text-[11px] font-semibold text-gray-600 uppercase">Confidential</span>
          </div>
          <div class="p-2.5 bg-white rounded border border-gray-100 shadow-xs text-center">
            <span class="block font-heading text-2xl font-bold text-amber-700">50K+</span>
            <span class="block text-[11px] font-semibold text-gray-600 uppercase">Happy Clients</span>
          </div>
          <div class="p-2.5 bg-white rounded border border-gray-100 shadow-xs text-center">
            <span class="block font-heading text-2xl font-bold text-amber-700">24-48h</span>
            <span class="block text-[11px] font-semibold text-gray-600 uppercase">Fast Remedies</span>
          </div>
        </div>

        <!-- High-Impact Action CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a 
            href="tel:+15103714626" 
            class="btn-primary-call text-base py-3.5 px-6 shadow-md shadow-red-900/20"
          >
            <svg class="w-5 h-5 text-white animate-pulse" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
            </svg>
            <span>Call Now: +1 510-371-4626</span>
          </a>

          <a 
            href="https://wa.me/15103714626" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary-whatsapp text-base py-3.5 px-6"
          >
            <span>💬 Chat on WhatsApp</span>
          </a>
        </div>

        <!-- Sanctuary Location Stamp -->
        <div class="flex items-center gap-2 text-xs font-semibold text-gray-600 pt-1">
          <svg class="w-4 h-4 text-amber-700 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
          </svg>
          <span>Sanctuary Address: <strong class="text-gray-900">7001 Hollywood Blvd, Los Angeles, CA 90028</strong></span>
        </div>

      </div>

      <!-- Right Column: Instant Consultation Appointment Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-xl border-2 border-amber-400 p-6 sm:p-8 shadow-xl shadow-amber-900/10 relative">
          
          <!-- Card Header -->
          <div class="text-center pb-5 mb-5 border-b border-gray-100">
            <span class="inline-block bg-red-100 text-red-800 text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
              Instant Astrological Guidance
            </span>
            <h2 class="font-heading text-2xl font-bold text-gray-900">
              Book Your Private Consultation
            </h2>
            <p class="text-xs text-gray-600 mt-1">
              Talk directly with Pandith Vikram Ji today. 100% Privacy Guaranteed.
            </p>
          </div>

          <!-- Quick Intake Form -->
          <form id="hero-quick-form" class="space-y-4">
            
            <div>
              <label for="h_name" class="block text-xs font-semibold text-gray-700 mb-1">Your Full Name *</label>
              <input 
                type="text" 
                id="h_name" 
                name="name" 
                required 
                placeholder="Enter your name" 
                class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="h_phone" class="block text-xs font-semibold text-gray-700 mb-1">Phone Number *</label>
                <input 
                  type="tel" 
                  id="h_phone" 
                  name="phone" 
                  required 
                  placeholder="+1 (555) 000-0000" 
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
                />
              </div>

              <div>
                <label for="h_service" class="block text-xs font-semibold text-gray-700 mb-1">Select Problem / Service *</label>
                <select 
                  id="h_service" 
                  name="service" 
                  required 
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all"
                >
                  <option value="Get Ex Love Back">Get Ex Love Back</option>
                  <option value="Black Magic Removal">Black Magic Removal</option>
                  <option value="Husband Wife Dispute">Husband Wife Dispute</option>
                  <option value="Family Problems">Family Problems</option>
                  <option value="Business & Financial Problem">Business & Finance</option>
                  <option value="Palm Reading & Horoscope">Palm & Kundali Reading</option>
                  <option value="Spiritual Healing">Spiritual Healing</option>
                  <option value="Other Life Issue">Other Life Issue</option>
                </select>
              </div>
            </div>

            <div>
              <label for="h_message" class="block text-xs font-semibold text-gray-700 mb-1">Briefly Describe Your Concern</label>
              <textarea 
                id="h_message" 
                name="message" 
                rows="2" 
                placeholder="Write your issue here..." 
                class="w-full px-3.5 py-2 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-900 focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none transition-all placeholder:text-gray-400"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full btn-primary-call py-3 text-sm font-bold shadow-md shadow-red-900/20 cursor-pointer"
            >
              Get Free Consultation Now ➔
            </button>

            <!-- Success Confirmation Banner -->
            <div id="hero-form-success" class="hidden p-3 bg-green-50 border border-green-200 text-green-800 rounded text-xs text-center font-semibold">
              ✓ Ingestion received! Pandith Vikram Ji will reach you on phone/WhatsApp within 15 minutes.
            </div>

          </form>

          <!-- Direct Call Line -->
          <div class="mt-4 pt-3 border-t border-gray-100 text-center">
            <span class="text-xs text-gray-500">Need Immediate Help Right Now?</span>
            <a href="tel:+15103714626" class="block text-sm font-bold text-red-800 hover:text-red-950 mt-0.5">
              Call Direct: +1 510-371-4626
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('hero-quick-form');
  const successBox = document.getElementById('hero-form-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successBox.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        successBox.classList.add('hidden');
      }, 7000);
    });
  }
</script>
