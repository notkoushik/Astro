---
// ThreeStarfield.astro - Subtle Astronomical Observatory Background & Coordinate Grid
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Subtle Canvas for Astronomical Stars & Crosshairs -->
  <canvas id="observatory-canvas" class="w-full h-full opacity-60"></canvas>
  
  <!-- Subtle Vignette & Grain Layer -->
  <div class="absolute inset-0 bg-radial-vignette"></div>

  <!-- Delicate Coordinate Crosshairs in Corners -->
  <div class="absolute top-8 left-8 text-[9px] font-mono text-[#9696A5]/30 tracking-widest hidden md:block">
    + 17°23'12" N &nbsp;|&nbsp; 78°28'42" E
  </div>
  <div class="absolute top-8 right-8 text-[9px] font-mono text-[#9696A5]/30 tracking-widest hidden md:block">
    ALT 44°12' &nbsp;|&nbsp; AZ 182°04'
  </div>
  <div class="absolute bottom-8 left-8 text-[9px] font-mono text-[#9696A5]/30 tracking-widest hidden md:block">
    EPOCH 2026.8 · VEDIC SIDEREAL
  </div>
</div>

<style>
  .bg-radial-vignette {
    background: radial-gradient(circle at 50% 30%, transparent 40%, rgba(5, 6, 11, 0.85) 90%);
  }
</style>

<script>
  function initAstronomicalCanvas() {
    const canvas = document.getElementById('observatory-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initStars();
    });

    interface CelestialNode {
      x: number;
      y: number;
      size: number;
      baseAlpha: number;
      alpha: number;
      pulseSpeed: number;
    }

    let stars: CelestialNode[] = [];
    const count = Math.min(100, Math.floor(window.innerWidth / 16));

    function initStars() {
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: Math.random() * 1.2 + 0.3,
          baseAlpha: Math.random() * 0.4 + 0.15,
          alpha: Math.random(),
          pulseSpeed: (Math.random() * 0.006 + 0.002) * (Math.random() > 0.5 ? 1 : -1),
        });
      }
    }

    initStars();

    let targetMouseX = 0;
    let targetMouseY = 0;
    let mouseX = 0;
    let mouseY = 0;

    window.addEventListener('mousemove', (e) => {
      targetMouseX = (e.clientX - width / 2) * 0.015;
      targetMouseY = (e.clientY - height / 2) * 0.015;
    });

    function render() {
      mouseX += (targetMouseX - mouseX) * 0.03;
      mouseY += (targetMouseY - mouseY) * 0.03;

      ctx.clearRect(0, 0, width, height);

      // Draw faint constellation lines
      ctx.lineWidth = 0.35;
      for (let i = 0; i < stars.length; i++) {
        for (let j = i + 1; j < stars.length; j++) {
          const dx = stars[i].x - stars[j].x;
          const dy = stars[i].y - stars[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 110) {
            const lineAlpha = (1 - dist / 110) * 0.06;
            ctx.strokeStyle = `rgba(242, 238, 231, ${lineAlpha})`;
            ctx.beginPath();
            ctx.moveTo(stars[i].x + mouseX, stars[i].y + mouseY);
            ctx.lineTo(stars[j].x + mouseX, stars[j].y + mouseY);
            ctx.stroke();
          }
        }
      }

      // Draw subtle stars
      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];
        star.alpha += star.pulseSpeed;
        if (star.alpha > 1 || star.alpha < 0.1) {
          star.pulseSpeed = -star.pulseSpeed;
        }

        const renderX = star.x + mouseX;
        const renderY = star.y + mouseY;

        ctx.fillStyle = '#f2eee7';
        ctx.globalAlpha = Math.max(0.08, Math.min(0.65, star.alpha * star.baseAlpha));
        ctx.beginPath();
        ctx.arc(renderX, renderY, star.size, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(render);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAstronomicalCanvas);
  } else {
    initAstronomicalCanvas();
  }
</script>
