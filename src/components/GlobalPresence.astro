---
// GlobalPresence.astro - Geodesic Observatory Directory
const usJurisdictions = [
  { name: 'California (Los Angeles HQ - Hollywood Blvd)', coord: '34°06\'N 118°20\'W' },
  { name: 'New York', coord: '40°42\'N 74°00\'W' },
  { name: 'Texas', coord: '31°58\'N 99°54\'W' },
  { name: 'Florida', coord: '27°40\'N 81°31\'W' },
  { name: 'Illinois', coord: '40°38\'N 89°23\'W' },
  { name: 'New Jersey', coord: '40°03\'N 74°31\'W' },
  { name: 'Pennsylvania', coord: '41°12\'N 77°11\'W' },
  { name: 'Georgia', coord: '32°09\'N 82°54\'W' },
  { name: 'Washington', coord: '47°45\'N 120°44\'W' },
  { name: 'Virginia', coord: '37°26\'N 78°39\'W' },
  { name: 'Massachusetts', coord: '42°24\'N 71°23\'W' },
  { name: 'Colorado', coord: '39°33\'N 105°47\'W' }
];

const canadaJurisdictions = [
  { name: 'Ontario (Toronto & Mississauga)', coord: '43°39\'N 79°23\'W' },
  { name: 'British Columbia (Vancouver)', coord: '49°15\'N 123°07\'W' },
  { name: 'Quebec (Montreal)', coord: '45°30\'N 73°34\'W' },
  { name: 'Alberta (Calgary & Edmonton)', coord: '51°03\'N 114°04\'W' },
  { name: 'Manitoba (Winnipeg)', coord: '49°53\'N 97°08\'W' }
];

const internationalJurisdictions = [
  { name: 'United Kingdom (London)', coord: '51°30\'N 00°07\'W' },
  { name: 'Switzerland (Zurich & Geneva)', coord: '47°22\'N 08°32\'E' },
  { name: 'United Arab Emirates (Dubai)', coord: '25°12\'N 55°16\'E' },
  { name: 'Australia (Sydney & Melbourne)', coord: '33°52\'S 151°12\'E' },
  { name: 'Singapore', coord: '01°21\'N 103°49\'E' }
];
---

<section id="coverage" class="py-32 relative border-t border-hairline">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 space-y-4">
      <div class="text-[10px] tracking-[0.35em] text-[#C8A45C] uppercase font-mono">
        GEODESIC REACH &bull; OBSERVATORY NETWORK
      </div>
      <h2 class="font-editorial text-4xl sm:text-5xl md:text-6xl text-[#F2EEE7] font-normal leading-[1.08]">
        Planetary Jurisdiction
      </h2>
      <p class="font-sans text-xs sm:text-sm text-[#9696A5] font-light leading-relaxed max-w-xl">
        Consciousness is non-local. Whether attending an in-person private sanctuary session or an encrypted high-definition video ephemeris reading, seekers across all territories receive identical precision.
      </p>
    </div>

    <!-- Minimal Geodesic Switcher -->
    <div class="border border-hairline bg-[#080A12]/80 p-8 sm:p-10 space-y-8">
      
      <!-- Tab Controls -->
      <div class="flex flex-wrap gap-4 border-b border-hairline pb-6 text-[10px] font-mono tracking-[0.22em] uppercase">
        <button type="button" class="geo-tab-btn text-[#C8A45C] border-b border-[#C8A45C] pb-2 cursor-pointer transition-colors" data-geo="usa">
          UNITED STATES SANCTUARIES
        </button>
        <button type="button" class="geo-tab-btn text-[#9696A5] hover:text-[#F2EEE7] pb-2 cursor-pointer transition-colors" data-geo="can">
          CANADIAN PROVINCES
        </button>
        <button type="button" class="geo-tab-btn text-[#9696A5] hover:text-[#F2EEE7] pb-2 cursor-pointer transition-colors" data-geo="int">
          INTERNATIONAL DIASPORA
        </button>
      </div>

      <!-- USA Pane -->
      <div id="geo-pane-usa" class="geo-pane">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {usJurisdictions.map((item) => (
            <div class="p-4 border border-hairline bg-[#05060B] space-y-1">
              <span class="text-xs font-editorial text-[#F2EEE7] block">{item.name}</span>
              <span class="text-[9px] font-mono text-[#9696A5]/60 block tracking-wider">{item.coord}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Canada Pane -->
      <div id="geo-pane-can" class="geo-pane hidden">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {canadaJurisdictions.map((item) => (
            <div class="p-4 border border-hairline bg-[#05060B] space-y-1">
              <span class="text-xs font-editorial text-[#F2EEE7] block">{item.name}</span>
              <span class="text-[9px] font-mono text-[#9696A5]/60 block tracking-wider">{item.coord}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- International Pane -->
      <div id="geo-pane-int" class="geo-pane hidden">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {internationalJurisdictions.map((item) => (
            <div class="p-4 border border-hairline bg-[#05060B] space-y-1">
              <span class="text-xs font-editorial text-[#F2EEE7] block">{item.name}</span>
              <span class="text-[9px] font-mono text-[#9696A5]/60 block tracking-wider">{item.coord}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const geoBtns = document.querySelectorAll('.geo-tab-btn');
  const geoPanes = document.querySelectorAll('.geo-pane');

  geoBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-geo');

      geoBtns.forEach((b) => {
        b.className = 'geo-tab-btn text-[#9696A5] hover:text-[#F2EEE7] pb-2 cursor-pointer transition-colors';
      });
      btn.className = 'geo-tab-btn text-[#C8A45C] border-b border-[#C8A45C] pb-2 cursor-pointer transition-colors';

      geoPanes.forEach((p) => {
        if (p.id === `geo-pane-${target}`) {
          p.classList.remove('hidden');
        } else {
          p.classList.add('hidden');
        }
      });
    });
  });
</script>
