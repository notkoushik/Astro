---
// GlobalPresence.astro - Clean White Service Locations Directory in California & USA
const californiaCities = [
  "Los Angeles (Hollywood Blvd HQ)", "Beverly Hills", "Glendale", "Pasadena", "Burbank",
  "Long Beach", "Santa Monica", "Anaheim", "Irvine", "Santa Ana",
  "San Diego", "San Jose", "San Francisco", "Sacramento", "Oakland", "Fresno"
];

const usaStates = [
  "California", "New York", "Texas", "Florida", "Illinois", "New Jersey",
  "Pennsylvania", "Georgia", "Washington", "Virginia", "Massachusetts", "Arizona",
  "North Carolina", "Ohio", "Michigan", "Colorado"
];

const internationalDiaspora = [
  "United States (Nationwide)", "Canada (Toronto, Vancouver, Montreal)",
  "United Kingdom (London, Birmingham)", "Australia (Sydney, Melbourne)",
  "United Arab Emirates (Dubai)", "Singapore", "New Zealand", "Europe"
];
---

<section id="locations" class="py-16 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-2">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3.5 py-1.5 rounded-full uppercase tracking-wider">
        <span>🌎 NATIONWIDE & GLOBAL REACH</span>
      </div>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-950">
        Astrology Services Across California & USA
      </h2>
      <p class="text-xs sm:text-sm text-gray-600">
        Pandith Vikram conducts both in-person private sessions at 7001 Hollywood Blvd, Los Angeles and phone/WhatsApp consultations across the USA and worldwide.
      </p>
    </div>

    <!-- 3 Location Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- California Cities -->
      <div class="bg-warm-ivory rounded-xl border border-amber-200/80 p-6 space-y-3">
        <div class="flex items-center gap-2 border-b border-amber-200 pb-2">
          <span class="text-xl">📍</span>
          <h3 class="font-heading text-base font-bold text-gray-900">California Cities Served</h3>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs text-gray-700 font-medium pt-1">
          {californiaCities.map((city) => (
            <span class="py-1 px-2 bg-white rounded border border-gray-100 shadow-2xs">
              • {city}
            </span>
          ))}
        </div>
      </div>

      <!-- USA States -->
      <div class="bg-warm-ivory rounded-xl border border-amber-200/80 p-6 space-y-3">
        <div class="flex items-center gap-2 border-b border-amber-200 pb-2">
          <span class="text-xl">🇺🇸</span>
          <h3 class="font-heading text-base font-bold text-gray-900">Major US States</h3>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs text-gray-700 font-medium pt-1">
          {usaStates.map((st) => (
            <span class="py-1 px-2 bg-white rounded border border-gray-100 shadow-2xs">
              • {st}
            </span>
          ))}
        </div>
      </div>

      <!-- International -->
      <div class="bg-warm-ivory rounded-xl border border-amber-200/80 p-6 space-y-3">
        <div class="flex items-center gap-2 border-b border-amber-200 pb-2">
          <span class="text-xl">🌐</span>
          <h3 class="font-heading text-base font-bold text-gray-900">Worldwide Diaspora</h3>
        </div>
        <div class="space-y-1.5 text-xs text-gray-700 font-medium pt-1">
          {internationalDiaspora.map((place) => (
            <div class="py-1 px-2.5 bg-white rounded border border-gray-100 shadow-2xs">
              ✓ {place}
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
