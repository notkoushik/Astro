---
// ThreeOrrery.astro - Cinematic Slanted Astronomical Planetary Orrery
---

<div class="relative w-full h-full select-none">
  <!-- Three.js Canvas Container filling the parent -->
  <div id="pbr-orrery-canvas" class="w-full h-full cursor-grab active:cursor-grabbing"></div>

  <!-- Micro Coordinate Ticks Overlay -->
  <div class="absolute top-6 right-8 text-[9px] font-mono text-[#9696A5]/40 tracking-widest pointer-events-none hidden lg:block">
    ORBITAL INCLINATION: 28.5° &bull; RA 18h 42m &bull; DEC -23°
  </div>
</div>

<script>
  import * as THREE from 'three';

  interface PlanetMeta {
    id: string;
    name: string;
    sanskrit: string;
    degree: string;
    sign: string;
    house: string;
    archetype: string;
    interpretation: string;
    dignity: string;
    nakshatra: string;
    radius: number;
    orbitDist: number;
    orbitSpeed: number;
    selfRotSpeed: number;
    texture: string;
  }

  const planetConfigs: Record<string, PlanetMeta> = {
    sun: {
      id: 'sun',
      name: 'SUN',
      sanskrit: 'SURYA',
      degree: '18°42\'',
      sign: 'LEO · SIMHA',
      house: 'HOUSE I · TANU BHAVA',
      archetype: 'SOUL · SOVEREIGNTY · VITALITY · LEADERSHIP',
      interpretation: 'The supreme soul indicator (Atmakaraka). Exalted solar radiance infuses the aura with authority, commanding respect in public life and establishing unwavering personal integrity.',
      dignity: 'MOOLATRIKONA (PARAMA SWAKSHETRA)',
      nakshatra: 'MAGHA (PITRIS)',
      radius: 2.5,
      orbitDist: 0,
      orbitSpeed: 0,
      selfRotSpeed: 0.002,
      texture: '/textures/planets/sun-map.jpg'
    },
    mercury: {
      id: 'mercury',
      name: 'MERCURY',
      sanskrit: 'BUDHA',
      degree: '08°52\'',
      sign: 'GEMINI · MITHUNA',
      house: 'HOUSE III · SAHAJA BHAVA',
      archetype: 'INTELLECT · SPEECH · COMMERCE · DISCERNMENT',
      interpretation: 'Mercury governs swift analytical intelligence, diplomacy, and commercial transactions. Facilitates profitable contractual signatures and eliminates miscommunications.',
      dignity: 'SWAKSHETRA (OWN HOUSE)',
      nakshatra: 'MRIGASHIRA (SOMA)',
      radius: 0.5,
      orbitDist: 5.2,
      orbitSpeed: 0.022,
      selfRotSpeed: 0.008,
      texture: '/textures/planets/mercury-map.jpg'
    },
    venus: {
      id: 'venus',
      name: 'VENUS',
      sanskrit: 'SHUKRA',
      degree: '24°10\'',
      sign: 'LIBRA · TULA',
      house: 'HOUSE VII · KALATRA BHAVA',
      archetype: 'DEVOTION · HARMONY · BEAUTY · UNION',
      interpretation: 'As the architect of romance and marital grace, Venusian alignment restores lost affection, dissolves estrangements, and anchors enduring soulmate devotion.',
      dignity: 'SWAKSHETRA (OWN HOUSE)',
      nakshatra: 'CHITRA (TVASHTAR)',
      radius: 0.72,
      orbitDist: 7.8,
      orbitSpeed: 0.015,
      selfRotSpeed: -0.005,
      texture: '/textures/planets/venus-map.jpg'
    },
    earth: {
      id: 'earth',
      name: 'EARTH',
      sanskrit: 'PRITHVI',
      degree: '20°00\'',
      sign: 'VIRGO · KANYA',
      house: 'HOUSE I · ASCENDANT ANCHOR',
      archetype: 'FOUNDATION · CONSCIOUSNESS · FORM',
      interpretation: 'The physical seat of human incarnation. Anchors celestial transits into grounded earthly reality and conscious spiritual awareness.',
      dignity: 'ANCHOR SEAT',
      nakshatra: 'HASTA (SAVITAR)',
      radius: 0.85,
      orbitDist: 10.6,
      orbitSpeed: 0.011,
      selfRotSpeed: 0.015,
      texture: '/textures/planets/earth-map-1.jpg'
    },
    mars: {
      id: 'mars',
      name: 'MARS',
      sanskrit: 'MANGAL',
      degree: '14°21\'',
      sign: 'SCORPIO · VRISHCHIKA',
      house: 'HOUSE VII · KENDRA BHAVA',
      archetype: 'ENERGY · ACTION · RESOLVE · COURAGE',
      interpretation: 'Mars occupies Scorpio, converting friction into purposeful momentum. Provides decisive protection against legal adversity and clears emotional blockages.',
      dignity: 'SWAKSHETRA (OWN HOUSE)',
      nakshatra: 'ANURADHA (MITRA DEVATA)',
      radius: 0.65,
      orbitDist: 13.6,
      orbitSpeed: 0.008,
      selfRotSpeed: 0.012,
      texture: '/textures/planets/mars-map.jpg'
    },
    jupiter: {
      id: 'jupiter',
      name: 'JUPITER',
      sanskrit: 'GURU',
      degree: '05°40\'',
      sign: 'SAGITTARIUS · DHANU',
      house: 'HOUSE IX · DHARMA BHAVA',
      archetype: 'WISDOM · EXPANSION · FORTUNE · DIVINE GRACE',
      interpretation: 'The great benefic (Devaguru) bestows moral fortitude, material expansion, auspicious progeny, and spiritual illumination across all houses he aspects.',
      dignity: 'MOOLATRIKONA',
      nakshatra: 'MULA (NIRRITI)',
      radius: 1.5,
      orbitDist: 18.2,
      orbitSpeed: 0.005,
      selfRotSpeed: 0.02,
      texture: '/textures/planets/jupiter-map.jpg'
    },
    saturn: {
      id: 'saturn',
      name: 'SATURN',
      sanskrit: 'SHANI',
      degree: '19°12\'',
      sign: 'CAPRICORN · MAKARA',
      house: 'HOUSE X · KARMA BHAVA',
      archetype: 'KARMA · TIME · DISCIPLINE · ENDURANCE',
      interpretation: 'Lord of Karma demands rectitude and patience. When appeased with Vedic prayers, Saturn rewards with lifelong generational prosperity and unshakeable stature.',
      dignity: 'SWAKSHETRA',
      nakshatra: 'SHRAVANA (VISHNU)',
      radius: 1.25,
      orbitDist: 23.0,
      orbitSpeed: 0.003,
      selfRotSpeed: 0.018,
      texture: '/textures/planets/saturn-map.jpg'
    }
  };

  function initCinematicOrrery() {
    const container = document.getElementById('pbr-orrery-canvas');
    if (!container) return;

    container.innerHTML = '';
    const width = container.clientWidth || window.innerWidth;
    const height = container.clientHeight || window.innerHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 1000);
    
    // Position camera for the cinematic angle shown in user reference
    camera.position.set(0, 16, 32);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.appendChild(renderer.domElement);

    const textureLoader = new THREE.TextureLoader();

    // The Master Group - Offset to the right to match media_1791313654101.png
    const masterGroup = new THREE.Group();
    scene.add(masterGroup);

    // Responsive offset: on desktop, shift center to the right
    const isDesktop = window.innerWidth >= 1024;
    masterGroup.position.set(isDesktop ? 7.2 : 0, -1.0, 0);

    // Slanted Plane Root: EXACT ANGLE matching user image
    // Slanted diagonally so orbit rings sweep from top-left across to bottom-right
    const slantedOrreryGroup = new THREE.Group();
    slantedOrreryGroup.rotation.x = 0.58;  // Pitch angle
    slantedOrreryGroup.rotation.y = -0.32; // Slight yaw
    slantedOrreryGroup.rotation.z = -0.18; // Diagonal roll slant
    masterGroup.add(slantedOrreryGroup);

    // 1. Lighting Setup
    const ambientLight = new THREE.AmbientLight(0x4a4468, 0.38);
    scene.add(ambientLight);

    // Subtle Camera Fill Light for planetary relief
    const cameraFillLight = new THREE.DirectionalLight(0x7e73a8, 0.35);
    cameraFillLight.position.set(0, 10, 20);
    scene.add(cameraFillLight);

    // High-Resolution 4K Deep Space Milky Way Galaxy Sky Dome
    const galaxyTex = textureLoader.load('/textures/planets/milkyway.jpg');
    galaxyTex.wrapS = THREE.RepeatWrapping;
    galaxyTex.wrapT = THREE.ClampToEdgeWrapping;
    const galaxyGeo = new THREE.SphereGeometry(180, 64, 40);
    const galaxyMat = new THREE.MeshBasicMaterial({
      map: galaxyTex,
      side: THREE.BackSide,
      transparent: true,
      opacity: 0.92
    });
    const galaxySkyDome = new THREE.Mesh(galaxyGeo, galaxyMat);
    // Align the brilliant 4K galactic core and dust lane directly behind the Sun and tilted planetary plane
    galaxySkyDome.rotation.x = 0.22;
    galaxySkyDome.rotation.y = 1.28;
    galaxySkyDome.rotation.z = -0.14;
    scene.add(galaxySkyDome);

    // 3D Stardust Field with Circular Gaussian Star Particles (Anti-aliased, zero square blocks)
    const starParticleTex = textureLoader.load('/textures/planets/star_particle.png');
    const starCount = 450;
    const starPositions = new Float32Array(starCount * 3);
    const starColors = new Float32Array(starCount * 3);
    const colorPalette = [
      new THREE.Color(0xf2eee7), // bone white
      new THREE.Color(0xc8a45c), // observatory warm gold
      new THREE.Color(0xa5beff), // crisp stellar blue
      new THREE.Color(0xffe0b2)  // celestial amber
    ];
    for (let i = 0; i < starCount; i++) {
      const dist = 40 + Math.random() * 115;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      starPositions[i * 3] = dist * Math.sin(phi) * Math.cos(theta);
      starPositions[i * 3 + 1] = dist * Math.sin(phi) * Math.sin(theta);
      starPositions[i * 3 + 2] = dist * Math.cos(phi);

      const col = colorPalette[Math.floor(Math.random() * colorPalette.length)];
      starColors[i * 3] = col.r;
      starColors[i * 3 + 1] = col.g;
      starColors[i * 3 + 2] = col.b;
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    starGeo.setAttribute('color', new THREE.BufferAttribute(starColors, 3));
    const starMat = new THREE.PointsMaterial({
      size: 0.75,
      map: starParticleTex,
      vertexColors: true,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const deepStarPoints = new THREE.Points(starGeo, starMat);
    scene.add(deepStarPoints);

    // Central Radiant Sun Light casting warm illumination on planets
    const sunPointLight = new THREE.PointLight(0xfff3db, 5.5, 95, 0.7);
    sunPointLight.position.set(0, 0, 0);
    slantedOrreryGroup.add(sunPointLight);

    // 2. Central Radiant Sun (Surya) - Photorealistic Solar Photosphere
    const sunTexture = textureLoader.load(planetConfigs.sun.texture);
    const sunGeo = new THREE.SphereGeometry(planetConfigs.sun.radius, 64, 64);
    const sunMat = new THREE.MeshBasicMaterial({
      map: sunTexture,
      color: 0xfff2de
    });
    const sunMesh = new THREE.Mesh(sunGeo, sunMat);
    slantedOrreryGroup.add(sunMesh);

    // Luminous Atmospheric Limb Shell (BackSide rim glow seamlessly eliminates hard edge)
    const atmosGeo = new THREE.SphereGeometry(planetConfigs.sun.radius * 1.05, 48, 48);
    const atmosMat = new THREE.MeshBasicMaterial({
      color: 0xffb833,
      side: THREE.BackSide,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const sunAtmos = new THREE.Mesh(atmosGeo, atmosMat);
    slantedOrreryGroup.add(sunAtmos);

    // Camera-Facing Inner Golden Solar Corona (True Volumetric Span)
    const coronaTexture = textureLoader.load('/textures/planets/sun_corona.png');
    const innerCoronaMat = new THREE.SpriteMaterial({
      map: coronaTexture,
      color: 0xffdf7a,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const innerCorona = new THREE.Sprite(innerCoronaMat);
    innerCorona.scale.set(13.0, 13.0, 1);
    slantedOrreryGroup.add(innerCorona);

    // Camera-Facing Outer Celestial Aura (Soft Diffuse Solar Atmosphere)
    const outerCoronaMat = new THREE.SpriteMaterial({
      map: coronaTexture,
      color: 0xff9922,
      transparent: true,
      opacity: 0.42,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const outerCorona = new THREE.Sprite(outerCoronaMat);
    outerCorona.scale.set(24.0, 24.0, 1);
    slantedOrreryGroup.add(outerCorona);

    // 3. Precision Hairline Orbit Lines (Pure Circles in Slanted Plane)
    function createPrecisionOrbitLine(radius: number, opacity: number = 0.12) {
      const segments = 128;
      const points: THREE.Vector3[] = [];
      for (let i = 0; i <= segments; i++) {
        const theta = (i / segments) * Math.PI * 2;
        points.push(new THREE.Vector3(Math.cos(theta) * radius, 0, Math.sin(theta) * radius));
      }
      const geo = new THREE.BufferGeometry().setFromPoints(points);
      const mat = new THREE.LineBasicMaterial({
        color: 0xf2eee7,
        transparent: true,
        opacity
      });
      return new THREE.Line(geo, mat);
    }

    // Outer Ecliptic Reference Ring
    const outerRing = createPrecisionOrbitLine(26.0, 0.18);
    slantedOrreryGroup.add(outerRing);

    // 4. Planets PBR Nodes
    interface ActivePlanet {
      id: string;
      mesh: THREE.Mesh;
      group: THREE.Group;
      dist: number;
      orbitSpeed: number;
      selfRotSpeed: number;
      angle: number;
      moonMesh?: THREE.Mesh;
      moonAngle?: number;
    }

    const activePlanets: ActivePlanet[] = [];

    // Angles calibrated to match the user's reference composition:
    // Mars & Jupiter on upper-left, Earth on lower-right foreground, Saturn with tilted rings
    const calibratedAngles: Record<string, number> = {
      mercury: 1.2,
      venus: 2.8,
      earth: 5.6,   // lower-right foreground
      mars: 2.1,    // upper-left
      jupiter: 2.4, // upper-left prominent
      saturn: 3.8   // midground
    };

    ['mercury', 'venus', 'earth', 'mars', 'jupiter', 'saturn'].forEach((pKey) => {
      const cfg = planetConfigs[pKey];
      if (!cfg) return;

      // Add Hairline Orbit Loop
      const orbitRing = createPrecisionOrbitLine(cfg.orbitDist);
      slantedOrreryGroup.add(orbitRing);

      // Planet Holder Group
      const pGroup = new THREE.Group();
      slantedOrreryGroup.add(pGroup);

      // Planet Mesh with Texture & PBR
      const tex = textureLoader.load(cfg.texture);
      const geo = new THREE.SphereGeometry(cfg.radius, 32, 32);
      const mat = new THREE.MeshStandardMaterial({
        map: tex,
        roughness: 0.65,
        metalness: 0.05
      });
      const mesh = new THREE.Mesh(geo, mat);
      pGroup.add(mesh);

      let moonMesh: THREE.Mesh | undefined;

      // Earth & Moon
      if (pKey === 'earth') {
        const moonTex = textureLoader.load('/textures/planets/earthMoon.png');
        const moonGeo = new THREE.SphereGeometry(0.35, 16, 16);
        const moonMat = new THREE.MeshStandardMaterial({ map: moonTex, roughness: 0.8 });
        moonMesh = new THREE.Mesh(moonGeo, moonMat);
        moonMesh.position.set(1.5, 0, 0);
        mesh.add(moonMesh);
      }

      // Saturn Rings
      if (pKey === 'saturn') {
        const ringTex = textureLoader.load('/textures/planets/saturn-rings.jpg');
        const ringGeo = new THREE.RingGeometry(1.6, 2.8, 64);
        const ringMat = new THREE.MeshStandardMaterial({
          map: ringTex,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.88,
          roughness: 0.5
        });
        const satRing = new THREE.Mesh(ringGeo, ringMat);
        satRing.rotation.x = Math.PI / 2.2;
        mesh.add(satRing);
      }

      activePlanets.push({
        id: cfg.id,
        mesh,
        group: pGroup,
        dist: cfg.orbitDist,
        orbitSpeed: cfg.orbitSpeed * 0.35,
        selfRotSpeed: cfg.selfRotSpeed,
        angle: calibratedAngles[pKey] || Math.random() * Math.PI * 2,
        moonMesh,
        moonAngle: 0
      });
    });

    // 5. Interactive Drag & Mouse Parallax (Maintains baseline cinematic slant)
    let isDragging = false;
    let prevMouse = { x: 0, y: 0 };
    let baselineRotX = 0.58;
    let baselineRotY = -0.32;
    let userOffsetRotX = 0;
    let userOffsetRotY = 0;

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevMouse = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    window.addEventListener('mousemove', (e) => {
      if (isDragging) {
        const dx = e.clientX - prevMouse.x;
        const dy = e.clientY - prevMouse.y;
        userOffsetRotY += dx * 0.004;
        userOffsetRotX += dy * 0.004;
        prevMouse = { x: e.clientX, y: e.clientY };
      }
    });

    // Mobile Touch
    let touchStart = { x: 0, y: 0 };
    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    });

    container.addEventListener('touchmove', (e) => {
      if (e.touches.length === 1) {
        const dx = e.touches[0].clientX - touchStart.x;
        const dy = e.touches[0].clientY - touchStart.y;
        userOffsetRotY += dx * 0.004;
        userOffsetRotX += dy * 0.004;
        touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    });

    // Resize Handler
    window.addEventListener('resize', () => {
      const newW = container.clientWidth;
      const newH = container.clientHeight;
      camera.aspect = newW / newH;
      camera.updateProjectionMatrix();
      renderer.setSize(newW, newH);

      const desktopNow = window.innerWidth >= 1024;
      masterGroup.position.set(desktopNow ? 7.2 : 0, -1.0, 0);
    });

    // 6. Smooth Animation Loop
    function animate() {
      requestAnimationFrame(animate);

      // Interpolate user offset smoothly
      slantedOrreryGroup.rotation.y = baselineRotY + userOffsetRotY;
      slantedOrreryGroup.rotation.x = baselineRotX + userOffsetRotX;

      // Imperceptible cosmic background drift
      galaxySkyDome.rotation.y += 0.00015;
      deepStarPoints.rotation.y += 0.00008;

      // Slow continuous solar rotation
      sunMesh.rotation.y += planetConfigs.sun.selfRotSpeed;

      // Subtle solar coronal breathing for organic radiance
      const time = performance.now() * 0.001;
      const pulse = 1 + Math.sin(time * 0.8) * 0.025;
      innerCorona.scale.set(13.0 * pulse, 13.0 * pulse, 1);
      outerCorona.scale.set(24.0 * (1 + Math.cos(time * 0.6) * 0.03), 24.0 * (1 + Math.cos(time * 0.6) * 0.03), 1);

      // Orbit and self-rotate planets along the slanted plane
      activePlanets.forEach((p) => {
        p.angle += p.orbitSpeed;
        p.mesh.position.x = Math.cos(p.angle) * p.dist;
        p.mesh.position.z = Math.sin(p.angle) * p.dist;

        p.mesh.rotation.y += p.selfRotSpeed;

        if (p.moonMesh && p.moonAngle !== undefined) {
          p.moonAngle += 0.035;
          p.moonMesh.position.x = Math.cos(p.moonAngle) * 1.5;
          p.moonMesh.position.z = Math.sin(p.moonAngle) * 1.5;
        }
      });

      renderer.render(scene, camera);
    }

    animate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCinematicOrrery);
  } else {
    initCinematicOrrery();
  }
</script>
