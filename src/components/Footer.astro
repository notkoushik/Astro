---
// Footer.astro - Minimal Observatory Footer
---

<footer class="relative bg-[#05060B] border-t border-hairline pt-24 pb-16">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <!-- Top Editorial Header & Newsletter -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-16 border-b border-hairline items-start">
      
      <!-- Left: Sanctuary Identity & Ephemeris Stamp -->
      <div class="lg:col-span-6 space-y-4">
        <a href="#top" class="inline-block">
          <span class="font-editorial text-3xl tracking-[0.08em] text-[#F2EEE7] font-medium block">
            PANDITH VIKRAM
          </span>
          <span class="text-[9px] uppercase tracking-[0.35em] text-[#9696A5] block mt-1">
            Indian Astrologer & Vedic Sanctuary
          </span>
        </a>

        <p class="font-sans text-xs text-[#9696A5] font-light max-w-md leading-relaxed">
          Preserving Rigvedic astronomical wisdom, horary synastry, and mathematical ephemeris analysis across three generations of dedicated familial lineage.
        </p>

        <div class="pt-2 text-[9px] font-mono tracking-widest text-[#9696A5]/50">
          HOLLYWOOD BLVD, LOS ANGELES &bull; 34°06'06" N · 118°20'40" W &bull; SIDEREAL LAHIRI
        </div>
      </div>

      <!-- Right: Monthly Ephemeris Dispatch -->
      <div class="lg:col-span-6">
        <div class="border border-hairline p-6 bg-[#080A12]/60 space-y-3">
          <span class="text-[10px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase block">
            LUNAR EPHEMERIS DISPATCH
          </span>
          <p class="text-xs text-[#9696A5] font-light leading-relaxed">
            Receive monthly notices on upcoming Purnima (full moon), Amavasya (new moon), solar eclipses, and critical planetary ingress dates.
          </p>

          <form id="footer-news-form" class="flex flex-col sm:flex-row gap-3 pt-2">
            <input 
              type="email" 
              required 
              placeholder="Enter your confidential email..." 
              class="flex-1 px-4 py-2.5 bg-[#05060B] border border-hairline text-xs text-[#F2EEE7] focus:border-[#C8A45C] outline-none rounded-none placeholder:text-[#9696A5]/40"
            />
            <button type="submit" class="btn-observatory-primary text-[10px] whitespace-nowrap">
              SUBSCRIBE TO EPHEMERIS
            </button>
          </form>
          <div id="footer-news-msg" class="hidden text-[11px] font-mono text-[#C8A45C] pt-1">
            &bull; Dispatch transmission recorded. Blessings upon your path.
          </div>
        </div>
      </div>

    </div>

    <!-- Navigation Columns Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-12 border-b border-hairline text-xs">
      
      <!-- Col 1 -->
      <div class="space-y-3">
        <span class="text-[9px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase block">
          OBSERVATORY CANON
        </span>
        <ul class="space-y-2 text-[#9696A5] font-light">
          <li><a href="#services" class="hover:text-[#F2EEE7] transition-colors">Love & Synastry Alignment</a></li>
          <li><a href="#services" class="hover:text-[#F2EEE7] transition-colors">Natal Kundali Blueprint</a></li>
          <li><a href="#services" class="hover:text-[#F2EEE7] transition-colors">Aura Defense & Cleansing</a></li>
          <li><a href="#services" class="hover:text-[#F2EEE7] transition-colors">Commercial Wealth Vastu</a></li>
          <li><a href="#services" class="hover:text-[#F2EEE7] transition-colors">Rigvedic Homa & Gemstones</a></li>
        </ul>
      </div>

      <!-- Col 2 -->
      <div class="space-y-3">
        <span class="text-[9px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase block">
          CELESTIAL EPHEMERIS
        </span>
        <ul class="space-y-2 text-[#9696A5] font-light">
          <li><a href="#zodiac" class="hover:text-[#F2EEE7] transition-colors">360° Ecliptic Arc</a></li>
          <li><a href="#top" class="hover:text-[#F2EEE7] transition-colors">Planetary Graha Telemetry</a></li>
          <li><a href="#matcher" class="hover:text-[#F2EEE7] transition-colors">Karmic Coordinate Diagnostic</a></li>
          <li><a href="#coverage" class="hover:text-[#F2EEE7] transition-colors">Geodesic Observatory Directory</a></li>
        </ul>
      </div>

      <!-- Col 3 -->
      <div class="space-y-3">
        <span class="text-[9px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase block">
          LINEAGE HERITAGE
        </span>
        <ul class="space-y-2 text-[#9696A5] font-light">
          <li><a href="#lineage" class="hover:text-[#F2EEE7] transition-colors">Three Generations of Mastery</a></li>
          <li><a href="#lineage" class="hover:text-[#F2EEE7] transition-colors">Sacred Code of Privacy</a></li>
          <li><a href="#testimonials" class="hover:text-[#F2EEE7] transition-colors">Chronicles of Truth</a></li>
        </ul>
      </div>

      <!-- Col 4 -->
      <div class="space-y-3">
        <span class="text-[9px] font-mono tracking-[0.25em] text-[#C8A45C] uppercase block">
          DIRECT CONDUIT
        </span>
        <div class="space-y-2 text-[#9696A5] font-mono text-[11px]">
          <div><a href="tel:+15103714626" class="hover:text-[#F2EEE7] transition-colors">+1 510-371-4626</a></div>
          <div><a href="https://wa.me/15103714626" target="_blank" rel="noopener noreferrer" class="text-[#C8A45C] hover:text-[#F2EEE7] transition-colors">WHATSAPP ENCRYPTED</a></div>
          <div class="text-[10px] text-[#9696A5]/80 pt-1 leading-relaxed">
            7001 Hollywood Blvd,<br />Los Angeles, CA 90028, United States
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="pt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-[10px] font-mono text-[#9696A5]/60">
      <div>
        &copy; {new Date().getFullYear()} PANDITH VIKRAM &bull; INDIAN ASTROLOGER &bull; ALL RIGHTS RESERVED
      </div>
      <div class="flex items-center gap-6">
        <a href="#top" class="hover:text-[#F2EEE7] transition-colors">
          RETURN TO CELESTIAL SUMMIT &uarr;
        </a>
      </div>
    </div>

  </div>
</footer>

<script>
  const nForm = document.getElementById('footer-news-form');
  const nMsg = document.getElementById('footer-news-msg');
  if (nForm && nMsg) {
    nForm.addEventListener('submit', (e) => {
      e.preventDefault();
      nMsg.classList.remove('hidden');
      (nForm as HTMLFormElement).reset();
    });
  }
</script>
