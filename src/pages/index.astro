---
import '../styles/global.css';

import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ServicesPillars from '../components/ServicesPillars.astro';
import MasterLineage from '../components/MasterLineage.astro';
import TestimonialGalaxy from '../components/TestimonialGalaxy.astro';
import ConsultationEngine from '../components/ConsultationEngine.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import Footer from '../components/Footer.astro';
import FloatingAuraDock from '../components/FloatingAuraDock.astro';

const pageTitle = "Indian Astrologer Pandith Vikram | Best Vedic Astrologer in Los Angeles, CA";
const pageDescription = "Consult master Indian astrologer Pandith Vikram at 7001 Hollywood Blvd, Los Angeles, CA 90028. Authentic Vedic astrology, birth chart (Kundali) readings, love reconciliation, negative energy removal, and 100% confidential spiritual solutions. Call: +1 510-371-4626.";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="Indian Astrologer Pandith Vikram, Astrologer Los Angeles, Astrologer Hollywood CA, Vedic Astrology California, Kundali Reading, Ex Love Back, Black Magic Removal, Spiritual Healer USA, Indian Astrologer in USA" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Pandith Vikram Indian Astrologer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data (Schema.org) for LocalBusiness & Astrologer -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Indian Astrologer Pandith Vikram",
        "telephone": "+15103714626",
        "priceRange": "$$",
        "image": "https://astrologervikram.com/og-image.jpg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "7001 Hollywood Blvd",
          "addressLocality": "Los Angeles",
          "addressRegion": "CA",
          "postalCode": "90028",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "34.1016",
          "longitude": "-118.3429"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "1250"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        }
      }
    </script>
  </head>

  <body class="relative bg-white text-gray-800 font-sans antialiased selection:bg-amber-500 selection:text-white pb-20 md:pb-0">
    
    <!-- Clean Top Bar & Navigation Bar -->
    <Navigation />

    <!-- Main Content Stream -->
    <main class="relative z-10 flex flex-col">
      <Hero />
      <ServicesPillars />
      <MasterLineage />
      <TestimonialGalaxy />
      <ConsultationEngine />
      <GlobalPresence />
    </main>

    <!-- Clean Commercial Footer -->
    <Footer />

    <!-- Sticky Mobile & Desktop Contact Hub -->
    <FloatingAuraDock />

  </body>
</html>
