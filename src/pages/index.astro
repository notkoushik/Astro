---
import '../styles/global.css';

import ThreeStarfield from '../components/ThreeStarfield.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ZodiacTransits from '../components/ZodiacTransits.astro';
import ServicesPillars from '../components/ServicesPillars.astro';
import CosmicMatcher from '../components/CosmicMatcher.astro';
import MasterLineage from '../components/MasterLineage.astro';
import TestimonialGalaxy from '../components/TestimonialGalaxy.astro';
import ConsultationEngine from '../components/ConsultationEngine.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import Footer from '../components/Footer.astro';
import FloatingAuraDock from '../components/FloatingAuraDock.astro';

const pageTitle = "Indian Astrologer Pandith Vikram | Vedic Sanctuary & Healer in Los Angeles, CA";
const pageDescription = "Consult master Indian astrologer Pandith Vikram at 7001 Hollywood Blvd, Los Angeles, CA 90028. Authentic Vedic astrology, birth chart (Kundali) readings, love reconciliation, negative energy defense, and sacred planetary remedies. Direct call: +1 510-371-4626.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="Indian Astrologer Pandith Vikram, Astrologer Los Angeles, Astrologer Hollywood, Vedic Astrology California, Kundali Reading, Love Reconciliation, Black Magic Removal, Spiritual Healer USA" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Pandith Vikram Vedic Sanctuary" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured Data (Schema.org) for LocalBusiness & Astrologer -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Indian Astrologer Pandith Vikram - Vedic Celestial Sanctuary",
        "telephone": "+15103714626",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "7001 Hollywood Blvd",
          "addressLocality": "Los Angeles",
          "addressRegion": "CA",
          "postalCode": "90028",
          "addressCountry": "US"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.98",
          "reviewCount": "4520"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        }
      }
    </script>
  </head>

  <body class="relative selection:bg-amber-400 selection:text-slate-950 font-sans antialiased text-slate-100">
    
    <!-- Background 3D Starfield & Particle Canvas -->
    <ThreeStarfield />

    <!-- Sticky Frosted Glass Navigation -->
    <Navigation />

    <!-- Main Content Stream -->
    <main class="relative z-10 flex flex-col">
      <Hero />
      <ZodiacTransits />
      <ServicesPillars />
      <CosmicMatcher />
      <MasterLineage />
      <TestimonialGalaxy />
      <ConsultationEngine />
      <GlobalPresence />
    </main>

    <!-- Celestial Vault Footer -->
    <Footer />

    <!-- Floating Quick Access Dock -->
    <FloatingAuraDock />

  </body>
</html>
